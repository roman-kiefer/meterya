# Copy to .env and replace every empty value before starting.
# Public hostname of your installation, e.g. energy.example.com (without https://).
PUBLIC_HOST=

# GitHub account providing the container images. Keep roman-kiefer for official images.
GHCR_OWNER=roman-kiefer
API_TAG=latest
APP_TAG=latest

# Use distinct random hex values, for example from: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
KC_DB_PASSWORD=
KC_ADMIN_PASSWORD=
OIDC_CLIENT_SECRET=
KEYCLOAK_SERVICE_SECRET=

# Keycloak SMTP uses STARTTLS. Quote values containing $ as single-quoted .env values.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Set this to the real Keycloak user ID after creating the first user.
OPERATOR_SUBJECT=
